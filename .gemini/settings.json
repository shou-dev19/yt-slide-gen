{
    "mcpServers": {
        "playwright": {
            "command": "npx",
            "args": [
                "@playwright/mcp@latest"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "js-genai-docs": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://gitmcp.io/googleapis/js-genai"
            ]
        },
        "pptx-gen-js-docs": {
            "command": "npx",
            "args": [
                "mcp-remote",
                "https://gitmcp.io/gitbrent/PptxGenJS/"
            ]
        }
    },
    "hasSeenIdeIntegrationNudge": true,
    "ide": {
        "enabled": true
    },
    "security": {
        "auth": {
            "selectedType": "oauth-personal"
        }
    },
    "general": {
        "previewFeatures": true
    }
}
